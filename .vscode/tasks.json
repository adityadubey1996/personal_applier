{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Steel Browser: start",
      "type": "shell",
      "command": "docker compose up -d steel-api && STEEL_API_PORT=\"${STEEL_API_PORT:-3000}\"; until curl -sf \"http://127.0.0.1:${STEEL_API_PORT}/v1/health\" >/dev/null; do sleep 2; done && echo 'Steel is ready.'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "V5: setup (venv + npm)",
      "type": "shell",
      "command": "./setup.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "V5 Frontend: dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": ".", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:\\s+http://localhost:5174"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "frontend"
      }
    }
  ]
}
